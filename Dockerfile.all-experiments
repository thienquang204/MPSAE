# syntax=docker/dockerfile:1
# MMRSAE ImageNet runner with the historical study entry points retained.
FROM nvidia/cuda:13.0.2-devel-ubuntu24.04

LABEL org.opencontainers.image.title="Graduate thesis adaptive-representation runner"
LABEL org.opencontainers.image.description="ImageNet representation studies and frozen detection, mask, and viewpoint transfer"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/opt/venv/bin:$PATH \
    HF_HOME=/data/huggingface \
    HF_DATASETS_CACHE=/data/huggingface/datasets \
    TORCH_HOME=/data/torch \
    TORCH_EXTENSIONS_DIR=/data/torch_extensions

WORKDIR /app

ARG TARGETARCH
ARG FAISS_VERSION=1.14.3

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       python3 python3-dev python3-venv git cmake ninja-build swig tini \
       build-essential libopenblas-dev libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

COPY requirements.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install --requirement requirements.txt

# No CUDA FAISS wheel supports the ARM64 GB10. Compile a native GPU build for
# compute capability 12.1 (sm_121) using the CUDA 13 toolkit in this image.
# amd64 continues to use the prebuilt wheel selected by requirements.txt.
RUN set -eu; if [ "$TARGETARCH" = "arm64" ]; then \
        git clone --branch "v${FAISS_VERSION}" --depth 1 https://github.com/facebookresearch/faiss.git /tmp/faiss; \
        cmake -S /tmp/faiss -B /tmp/faiss/build -G Ninja \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_CUDA_ARCHITECTURES=121 \
          -DFAISS_ENABLE_GPU=ON \
          -DFAISS_ENABLE_PYTHON=ON \
          -DFAISS_ENABLE_CUVS=OFF \
          -DFAISS_OPT_LEVEL=generic \
          -DFAISS_ENABLE_EXTRAS=OFF \
          -DBUILD_TESTING=OFF \
          -DBUILD_SHARED_LIBS=OFF \
          -DBLA_VENDOR=OpenBLAS \
          -DPython_EXECUTABLE=/opt/venv/bin/python; \
        cmake --build /tmp/faiss/build --target swigfaiss --parallel "$(nproc)"; \
        python -m pip install /tmp/faiss/build/faiss/python; \
        rm -rf /tmp/faiss; \
    fi

RUN python -c "import faiss; assert hasattr(faiss, 'StandardGpuResources'), 'image contains CPU-only FAISS'"

COPY csr_vs_mmpot_imagenet.py sparse_gpu_retrieval.py retrieval_timing.py wandb_tracking.py \
     aggregate_backbone_results.py download_imagenet.py \
     container_pipeline.sh experiment_shell_common.sh run_csr_vs_mmpot_imagenet.sh \
     run_all_experiments_container.sh ./
COPY csrc/ ./csrc/
COPY transfer_experiments.py transfer_representations.py transfer_data.py transfer_tasks.py transfer_reporting.py \
     run_transfer_experiments.sh ./
COPY mpsae_repair.py mpsae_repair_experiment.py repair_data.py repair_runtime.py repair_benchmark.py \
     prepare_splits.py compare_predictions.py make_plan.py check_reference.py \
     experiments.json run_matrix.csv run_mpsae_repair.sh ./
COPY mmrsae.py mmrsae_dictionary.py dlmmsae.py mmrsae_probe.py mmrsae_gpu.py mmrsae_data.py mmrsae_imagenet.py mmrsae_reporting.py export_rn18_embeddings.py run_mmrsae_imagenet.sh ./

RUN chmod +x /app/container_pipeline.sh /app/run_csr_vs_mmpot_imagenet.sh \
    /app/run_all_experiments_container.sh /app/run_transfer_experiments.sh \
    /app/run_mpsae_repair.sh /app/run_mmrsae_imagenet.sh

RUN mkdir -p /data/csr_precompute_embeds /data/imagenet1k \
    /data/huggingface /data/torch /data/torch_extensions /output

VOLUME ["/data", "/output"]

ENTRYPOINT ["/usr/bin/tini", "--", "/app/run_all_experiments_container.sh"]

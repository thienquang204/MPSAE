# Angular-only revision of the full_theory_detail.md study; no transfer tasks.
# Use the updated experiments.json (mpsae-repair-angular-v2); mixed OT is disabled.
# Copy this file to repair.env, copy/edit experiments.json, then use:
#   ENV_FILE=repair.env bash run_all_experiments_docker.sh plan
#   ENV_FILE=repair.env bash run_all_experiments_docker.sh pilot
# CLI stage overrides REPAIR_STAGE; exported values override file defaults.
EXPERIMENT_SCOPE=repair
REPAIR_STAGE=plan
REPAIR_CONFIG=experiments.json
# REPAIR_CONFIG is a host path, relative to this repository unless absolute.
# The host launcher uses it for planning and mounts it read-only for execution.
# Set source.revision and source.train_sha256 from trusted release metadata
# in a configuration copy before prepare/pilot. Nulls permit planning only.
SUITE_DIR=mpsae_repair
OUTPUT_ROOT=runs
DATA_VOLUME=graduate-thesis-imagenet
# Optional existing SERVER directory mounted read/write at /data.
# Empty uses DATA_VOLUME. Paths for REPAIR_*_NPZ inside Docker still use /data/...
DATA_HOST_DIR=
# Select one physical server GPU with device=0; it becomes cuda:0 inside Docker.
DOCKER_GPUS=all
IMAGE_NAME=graduate-thesis-three-method-ablation:latest
SHM_SIZE=16g
PULL_BASE_IMAGE=0
REPAIR_DEVICE=cuda:0
FF2048_TRAIN_EMBEDDINGS=/data/csr_precompute_embeds/FF2048_RN50_Embeds/1K_train_ff2048.npz
FF2048_VAL_EMBEDDINGS=/data/csr_precompute_embeds/FF2048_RN50_Embeds/1K_val_ff2048.npz
# Archives must already exist in the persistent data volume. The research
# launcher never downloads datasets, opens validation during pilot selection,
# or starts legacy transfer preparation. The pilot command runs GPU preflight,
# config-derived split preparation, checks, and W/C/S/N (1,000 default updates).
# Standalone preflight/prepare/check/triage stages remain available.
# For direct execution, set the archive paths above to LOCAL filesystem paths:
#   ENV_FILE=repair.local.env bash run_mpsae_repair.sh pilot
# All model/loss/optimizer/bank/OT/retrieval settings live in REPAIR_CONFIG.
# Later stages, selected explicitly after reviewing decisions.json:
# attribution, wide (optional), timing, lock, holdout, confirm.
# Set REPAIR_CANDIDATE to the selected completed arm before lock.
# REPAIR_CANDIDATE=N
# REPAIR_VAL_SHA256 is a trusted validation archive digest, consumed only by
# confirmation when source.validation_sha256 was not predeclared in the config.

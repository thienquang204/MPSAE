# Fill these tokens, then: bash all_in_one.sh
# setup_server.sh creates .env only if absent.
# Runtime/credentials go here; scientific settings go in configs/thesis.yaml.
#   source activate_server.sh
#   bash all_in_one.sh --skip-setup
# .env is gitignored. Token values are excluded from logs and manifests.

# ---------------------------------------------------------------- required ---

# Hugging Face token: write access to create/upload <your-account>/MPSAE
# (private result backup). The default campaign pulls public embeddings;
# it does not need gated ImageNet access. Building new ImageNet embeddings
# separately requires accepting https://huggingface.co/datasets/ILSVRC/imagenet-1k
# and granting read access as well.
HF_TOKEN=

# ---------------------------------------------------------------- optional ---

# W&B token. Project defaults to cvpr and is created by the first online run.
# WANDB_API_KEY is also accepted for existing environments.
WANDB_TOKEN=
# WANDB_PROJECT=cvpr                  # optional override

# The all-in-one runner derives <HF account>/MPSAE from HF_TOKEN.
# Legacy 'stage publish' only: optional explicit destination.
# HF_EMBEDDINGS_REPO=

# Precomputed feature library, separate from your private result backup.
# Public downloads need no token; building/uploading requires a private repo
# you can write. Also selectable with embeddings_hub --repo owner/name.
# MPSAE_EMBEDDINGS_REPO=Lukita/MPSAE-embeddings

# ------------------------------------------------------------------ tuning ---

# Runtime settings below have defaults. Select backbones/methods/seeds/K in
# configs/thesis.yaml; the MPSAE_BACKBONES/METHODS/SEEDS/K vars are legacy-only.
# MPSAE_WORKSPACE=/workspace/mpsae     # default: ./work; see docs/server.md for peak disk budget
# MPSAE_DEVICE=cuda:0
# MPSAE_BACKBONES=ff2048,rn18,convnext_tiny,vit_b16,dinov2_vits14
# MPSAE_METHODS=csr,csrv2,mpsae,mpsaev2,csr_multitopk
# MPSAE_SEEDS=1227,2026,2027
# MPSAE_K=                             # restrict budgets, e.g. 8,64
# MPSAE_WORKERS=16                     # JPEG decode workers
# MPSAE_EMBED_BATCH=256
# MPSAE_LOG_LEVEL=INFO                 # DEBUG for step-level detail
# HF_HOME=/workspace/hf                # move the Hugging Face cache off /

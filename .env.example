# Docker Compose: copy this template to .env, configure access, then start.
#   cp .env.example .env
#   # edit .env: HF_TOKEN, WANDB_API_KEY, WANDB_ENTITY
#   docker compose up
# Docker Engine must be running on the server: confirm with docker info there.
# Background run: docker compose up -d
# Status: docker compose ps -a
# Logs: docker compose logs -f --tail 100 imagenet
# The Compose service always runs ImageNet-only MMRSAE, with the settings below.
# Historical settings are retained for the separate shell launchers.

# Read access to quangnguyenopt/NSFW is needed for automatic embedding downloads.
# Local NPZ/JSON pairs work offline without a token. Raw ImageNet access is
# needed only for the explicitly selected legacy/export workflow.
HF_TOKEN=

# W&B monitoring is enabled. Compose requires a nonempty API key before build.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=MMRSAE
WANDB_MODE=online
WANDB_GROUP=imagenet-manual
WANDB_TAGS=imagenet,mmrsae,manual-tuning

# Persistent Docker locations and ImageNet preparation.
# Compose selects one physical GPU; it becomes cuda:0 inside the container.
GPU_DEVICE_ID=0
# Compose defaults to ./data and creates host directories if needed.
# Set an explicit path to use a large data disk. When empty, the separate
# shell launcher uses DATA_VOLUME instead.
DATA_HOST_DIR=
EXPERIMENT_SCOPE=mmrsae
MMRSAE_DEVICE=cuda:0
MMRSAE_BACKBONES=resnet50,resnet18
MMRSAE_VARIANT=mmrsae
# Comma-separated methods run sequentially by one `docker compose up`;
# overrides MMRSAE_VARIANT when set.
MMRSAE_VARIANTS=mmrsae,mmrsae-rel,mmrsae-wide,mmrsae-annealed,mpsae,csr
# Mixed MMRSAE presets use rho=0.2: 0.8 angular + 0.2 neighborhood cost.
# Leave empty for method-specific defaults; MPSAE/CSR use no neighborhood cost.
MMRSAE_MIXTURE_WEIGHT=
MMRSAE_K=8
MMRSAE_SEED=1227
MMRSAE_DATA_SEED=42
MMRSAE_EPOCHS=10
# Current development workload: 500 updates per backbone, training-derived queries.
# For a full official run, explicitly set MAX_STEPS=0, TRAIN_SIZE=0 and
# EVALUATION=official using the MMRSAE_ variable names below.
MMRSAE_MAX_STEPS=500
MMRSAE_BATCH_SIZE=1024
MMRSAE_TRAIN_SIZE=128000
MMRSAE_DEV_SIZE=10000
MMRSAE_ANCHOR_COUNT=1024
MMRSAE_EVALUATION=dev
MMRSAE_DOWNLOAD=1
MMRSAE_EMBEDDING_SOURCE=precomputed
MMRSAE_EMBEDDINGS_REPO=quangnguyenopt/NSFW
MMRSAE_EMBEDDINGS_REPO_TYPE=model
MMRSAE_EMBEDDINGS_REVISION=main
MMRSAE_EMBEDDINGS=/data/embeddings
# Used only when MMRSAE_EMBEDDING_SOURCE=legacy and RN18 needs exporting.
MMRSAE_DATA_BACKEND=hf
MMRSAE_DATA_ROOT=/data/imagenet1k
MMRSAE_CACHE=/data/mmrsae
# Further manual settings are listed in mmrsae.env.example.
# The legacy ImageNet fields below apply only to scope imagenet/all.
# For the budgeted research screen, change EXPERIMENT_SCOPE=repair and
# SUITE_DIR=mpsae_repair. Start with REPAIR_STAGE=plan (no Docker build/data).
# Training stages are explicit; this scope never launches the transfer grid.
REPAIR_STAGE=plan
# REPAIR_CONFIG=your_config.json
# This is an existing HOST file, mounted read-only by Docker.
# REPAIR_TRAIN_NPZ defaults to FF2048_TRAIN_EMBEDDINGS below.
# REPAIR_OUTPUT defaults to /output/<SUITE_DIR>.
# REPAIR_SPLITS defaults to <REPAIR_OUTPUT>/splits.
# REPAIR_CACHE=/data/mpsae_repair_cache
# REPAIR_CANDIDATE=N
# REPAIR_VAL_NPZ is consumed only by the explicit confirmation stage.
# REPAIR_VAL_SHA256 may pin a trusted validation hash at confirmation if the
# immutable pilot configuration left source.validation_sha256 null.
DATA_VOLUME=graduate-thesis-imagenet
EXPERIMENT_PROTOCOL=paper_ff2048
BACKBONES=resnet50
DATA_ROOT=/data/csr_precompute_embeds
DATA_PREP=paper_embeddings
HF_DATASET_ID=W1nd-navigator/CSR-precompute-embeds
HF_REVISION=main
FF2048_TRAIN_EMBEDDINGS=/data/csr_precompute_embeds/FF2048_RN50_Embeds/1K_train_ff2048.npz
FF2048_VAL_EMBEDDINGS=/data/csr_precompute_embeds/FF2048_RN50_Embeds/1K_val_ff2048.npz
OUTPUT_ROOT=runs
SUITE_DIR=mmrsae
IMAGE_NAME=graduate-thesis-mmrsae:latest
SHM_SIZE=16g
PULL_BASE_IMAGE=0

# New strict frozen-transfer suite. Independent settings preserve the legacy
# ImageNet recipe above. Explicit historical scopes: all, imagenet, transfer, repair.
TRANSFER_TASKS=detection,mask,pose
TRANSFER_ARCHITECTURES=resnet18,resnet50
TRANSFER_METHODS=matryoshka,csr,mpsae,csrv2,mpsaev2
TRANSFER_SEEDS=0,1,2
TRANSFER_DATA_ROOT=/data/transfer
TRANSFER_CACHE=/data/transfer_cache
TRANSFER_IMAGENET_ROOT=/data/imagenet1k
TRANSFER_IMAGENET_BACKEND=hf
TRANSFER_IMAGENET_DATASET_ID=ILSVRC/imagenet-1k
TRANSFER_IMAGENET_REVISION=main
# TRANSFER_OUTPUT defaults to /output/<SUITE_DIR>/frozen_transfer.
TRANSFER_DOWNLOAD=1
TRANSFER_VERIFY_IMAGES=1
TRANSFER_WORKERS=4
TRANSFER_FEATURE_BATCH_SIZE=64
TRANSFER_ENCODE_BATCH_SIZE=1024
TRANSFER_LOG_EVERY=25
TRANSFER_PROPOSAL_BUDGET=256
# Optional overrides for existing local resources or alternate download mirrors.
TRANSFER_EDGE_MODEL=
TRANSFER_EDGE_MODEL_URL=
TRANSFER_PASCAL3D_ROOT=
TRANSFER_PASCAL3D_URL=
TRANSFER_VOC2007_TRAINVAL_URL=
TRANSFER_VOC2007_TEST_URL=
TRANSFER_VOC2012_URL=

# Runtime controls. paper_ff2048 is ResNet-50 only.
DEVICE=cuda
WORKERS=8
PREFETCH_FACTOR=2
AMP=0
CHANNELS_LAST=1
TF32=0
SEED=1227
STUDY_SEEDS=1227

# Matched training and evaluation setting.
ABLATION_EPOCHS=10
MPSAEV2_EXTRA_EPOCHS=0
ABLATION_BATCH_SIZE=4096
FEATURE_BATCH_SIZE=512
MAX_TRAIN=0
MAX_VAL=0
HIDDEN_DIM=8192
TRAIN_K=2
# V1_TRAIN_K is used only by the legacy single-model ablation and as the
# representative history selector. Strict paper CSR/MPSAE trains every K.
V1_TRAIN_K=32
ANNEAL_START_K=64
ANNEAL_FRACTION=0.7
# Table 3 budgets are 8..2048. No unreported sparse-only budgets are mixed
# into the strict reproduction.
SPARSE_EXTRA_TOPK=
# Exact GPU retrieval; use the same query batch for dense and sparse timing.
KNN_QUERY_BATCH=32
SPARSE_KNN_QUERY_BATCH=32
SPARSE_GALLERY_CHUNK=65536
RETRIEVAL_WARMUP=3
RETRIEVAL_REPEATS=5
SPARSE_SCORE_BUFFER_MIB=256
SPARSE_GPU_MEMORY_FRACTION=0.8

# Loss-component coefficients. Set a component to 0 to disable it, except
# MRL_CLASSIFICATION_WEIGHT, which must remain positive. The v1 and v2 variants
# share their family loss weights; at least one component per family must remain positive.
MRL_CLASSIFICATION_WEIGHT=1.0
CSRV2_MAIN_RECON_WEIGHT=1.0
CSRV2_MULTI_TOPK_RECON_WEIGHT=0.125
CSRV2_AUX_RECON_WEIGHT=0.03125
CSRV2_CONTRASTIVE_WEIGHT=0.1
MPSAEV2_MAIN_RECON_WEIGHT=1.0
MPSAEV2_NESTED_RECON_WEIGHT=0.125
MPSAEV2_AUX_RECON_WEIGHT=0.03125
MPSAEV2_MMPOT_WEIGHT=2.0

# Optimizer coefficients.
MPSAEV2_LR=4e-5
CSRV2_LR=4e-5
# MRL_LR/MRL_MOMENTUM apply only to torchvision_ablation. Paper mode uses
# the published MRL Table 4 curve and does not locally fine-tune MRL.
MRL_LR=0.475
MRL_MOMENTUM=0.9
WEIGHT_DECAY=1e-4
ADAM_EPS=6.25e-10
CONTRASTIVE_TEMPERATURE=0.2
OT_MASS=0.9
OT_ETA=0.2
OT_ITERS=100
OT_MICROBATCH=32
FAISS_GPU=1
FAISS_GPU_DEVICE=0
FAISS_TEMP_MEMORY_MIB=512
REBUILD_CACHE=0
FEATURE_CACHE=/data/three_method_feature_cache
WEIGHTS_CACHE=/data/torch

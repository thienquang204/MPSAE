# setup_server.sh creates .env only if absent; fill in HF_TOKEN afterwards.
# Runtime/credentials go here; scientific settings go in configs/thesis.yaml.
#   source scripts/activate_server.sh
#   python -m mpsae --config configs/thesis.yaml run
# .env is gitignored. Nothing here is ever written to a log or a manifest.

# ---------------------------------------------------------------- required ---

# Hugging Face token. Needs two things:
#   1. read access to the gated ImageNet-1k dataset. Accept the terms once at
#      https://huggingface.co/datasets/ILSVRC/imagenet-1k
#   2. write scope, if you want the embedding archives published (below).
HF_TOKEN=

# ---------------------------------------------------------------- optional ---

# Optional legacy 'stage publish' destination. Campaign runs keep results local.
# Setting it for the legacy publish stage authorises a PRIVATE dataset upload --
# ImageNet-derived features inherit the dataset's non-commercial terms.
HF_EMBEDDINGS_REPO=

# Weights & Biases. Both must be set for logging to be enabled; metrics are
# always written to work/runs/**/train.jsonl regardless.
WANDB_API_KEY=
WANDB_PROJECT=

# ------------------------------------------------------------------ tuning ---

# Runtime settings below have defaults. Select backbones/methods/seeds/K in
# configs/thesis.yaml; the MPSAE_BACKBONES/METHODS/SEEDS/K vars are legacy-only.
# MPSAE_WORKSPACE=/workspace/mpsae     # default: ./work  (needs ~500 GB)
# MPSAE_DEVICE=cuda:0
# MPSAE_BACKBONES=ff2048,rn18,convnext_tiny,vit_b16,dinov2_vits14
# MPSAE_METHODS=csr,csrv2,mpsae,mpsaev2,csr_multitopk
# MPSAE_SEEDS=1227,2026,2027
# MPSAE_K=                             # restrict budgets, e.g. 8,64
# MPSAE_WORKERS=16                     # JPEG decode workers
# MPSAE_EMBED_BATCH=256
# MPSAE_LOG_LEVEL=INFO                 # DEBUG for step-level detail
# HF_HOME=/workspace/hf                # move the Hugging Face cache off /

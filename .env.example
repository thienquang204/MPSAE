# One-command Matryoshka / CSR-MPSAE v1-v2 ImageNet ablation:
#   cp .env.example .env
#   # accept the ImageNet terms and replace HF_TOKEN
#   bash run_all_experiments_docker.sh

HF_TOKEN=hf_replace_with_a_new_read_only_token

# Optional Weights & Biases monitoring.
WANDB_API_KEY=
WANDB_ENTITY=tdnthienquang-home
WANDB_PROJECT=MPSAEv2
WANDB_MODE=
WANDB_GROUP=five-arm-ablation
WANDB_TAGS=imagenet,matryoshka,csr,mpsae,csrv2,mpsaev2,resnet18,resnet50

# Persistent Docker locations and ImageNet preparation.
DATA_VOLUME=graduate-thesis-imagenet
DATA_ROOT=/data/huggingface
DATA_PREP=auto
IMAGENET_SPLITS=train,validation
HF_DATASET_ID=ILSVRC/imagenet-1k
HF_REVISION=main
OUTPUT_ROOT=runs
SUITE_DIR=three_method_ablation
IMAGE_NAME=graduate-thesis-three-method-ablation:latest
SHM_SIZE=16g
PULL_BASE_IMAGE=0

# Runtime controls. The launcher always runs all five arms on both
# ResNet-18 and ResNet-50; those study factors are intentionally not variable.
DEVICE=cuda
WORKERS=8
PREFETCH_FACTOR=2
AMP=1
CHANNELS_LAST=1
SEED=42

# Matched training and evaluation setting.
ABLATION_EPOCHS=10
MPSAEV2_EXTRA_EPOCHS=4
ABLATION_BATCH_SIZE=1024
FEATURE_BATCH_SIZE=512
MAX_TRAIN=0
MAX_VAL=0
HIDDEN_DIM=8196
TRAIN_K=2
V1_TRAIN_K=32
ANNEAL_START_K=64
ANNEAL_FRACTION=0.7
# Matched budgets are fixed by backbone: ResNet-18 uses 8..512 and
# ResNet-50 uses 8..2048. These lower budgets apply only to sparse methods.
SPARSE_EXTRA_TOPK=1,2,4
SPARSE_KNN_QUERY_BATCH=32

# Loss-component coefficients. Set a component to 0 to disable it, except
# MRL_CLASSIFICATION_WEIGHT, which must remain positive. The v1 and v2 variants
# share their family loss weights; at least one component per family must remain positive.
MRL_CLASSIFICATION_WEIGHT=1.0
CSRV2_MAIN_RECON_WEIGHT=1.0
CSRV2_MULTI_TOPK_RECON_WEIGHT=0.125
CSRV2_AUX_RECON_WEIGHT=0.03125
CSRV2_CONTRASTIVE_WEIGHT=1.0
MPSAEV2_MAIN_RECON_WEIGHT=1.0
MPSAEV2_NESTED_RECON_WEIGHT=0.125
MPSAEV2_AUX_RECON_WEIGHT=0.03125
MPSAEV2_MMPOT_WEIGHT=1.3

# Optimizer coefficients.
MPSAEV2_LR=4e-5
CSRV2_LR=1e-4
MRL_LR=1e-2
MRL_MOMENTUM=0.9
WEIGHT_DECAY=1e-4
OT_MASS=0.9
OT_ETA=0.2
OT_ITERS=100
OT_MICROBATCH=32
FAISS_GPU_DEVICE=0
FAISS_TEMP_MEMORY_MIB=512
REBUILD_CACHE=0
FEATURE_CACHE=/data/three_method_feature_cache
WEIGHTS_CACHE=/data/torch

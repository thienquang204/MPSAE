# Configuration for the single-command Docker suite:
#   cp .env.example .env
#   # replace HF_TOKEN after accepting the ImageNet terms
#   bash run_all_experiments_docker.sh

HF_TOKEN=hf_replace_with_a_new_read_only_token

# Full-suite selection and persistent locations.
SUITE_EXPERIMENTS=csr_vs_mpsae,mmpot_proxy,mmpot_true
DATA_VOLUME=graduate-thesis-imagenet
DATA_ROOT=/data/huggingface
DATA_PREP=auto
IMAGENET_SPLITS=train,validation
HF_DATASET_ID=ILSVRC/imagenet-1k
HF_REVISION=main
OUTPUT_ROOT=runs
SUITE_DIR=all_experiments
IMAGE_NAME=graduate-thesis-all-experiments:latest
SHM_SIZE=16g
PULL_BASE_IMAGE=0

# Shared runtime controls.
DEVICE=cuda
WORKERS=8
PREFETCH_FACTOR=2
AMP=1
CHANNELS_LAST=1
SEED=42

# Controlled architecture ablation. ResNet-18 and ResNet-50 use the same
# training/evaluation settings; append ,swin_t only for an extended study.
CSR_BACKBONES=resnet18,resnet50
# Keep both comparison arms enabled so the method effect can be calculated.
CSR_METHOD=both
CSR_EPOCHS=10
CSR_BATCH_SIZE=1024
CSR_FEATURE_BATCH_SIZE=512
CSR_MAX_TRAIN=0
CSR_MAX_VAL=0
CSR_HIDDEN_DIM=0
CSR_TRAIN_K=32
CSR_TOPK=8,16,32,64,128,256
CSR_LR=4e-5
CSR_MRL_LR=1e-2
CSR_MRL_MOMENTUM=0.9
CSR_WEIGHT_DECAY=1e-4
CSR_OT_MASS=0.9
CSR_OT_ETA=0.2
CSR_OT_ITERS=100
CSR_OT_MICROBATCH=32
CSR_FAISS_GPU_DEVICE=0
CSR_FAISS_TEMP_MEMORY_MIB=512
CSR_REBUILD_CACHE=0
CSR_RESUME=1
CSR_CACHE_DIR=/data/csr_feature_cache
CSR_WEIGHTS_CACHE=/data/torch

# Pairwise-proxy and true multi-marginal Matryoshka experiments.
MMPOT_ARCHITECTURE=resnet50
MMPOT_METHOD=both
MMPOT_EPOCHS=5
MMPOT_BATCH_SIZE=256
MMPOT_BENCHMARKS=head,linear
MMPOT_PROBE_EPOCHS=5
MMPOT_OPTIMIZERS=sgd
MMPOT_SGD_LR=0.1
MMPOT_ADAM_LR=0.001
MMPOT_MOMENTUM=0.9
MMPOT_WEIGHT_DECAY=1e-4
MMPOT_OT_LAMBDA=0.5
MMPOT_OT_MASS=0.8
MMPOT_OT_ETA=0.1
MMPOT_OT_ITERS=50
MMPOT_OT_GRAD=envelope
MMPOT_OT_SOLVER_MODE=cyclic
MMPOT_MAX_TRAIN_BATCHES=0
MMPOT_MAX_VAL_BATCHES=0
MMPOT_PRETRAINED=1
MMPOT_RESUME=1

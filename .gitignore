__pycache__/
*.pyc

# Credentials. .env.example is the template; .env never gets committed.
.env
*.env
!.env.example

# The pipeline workspace: ImageNet, FFCV files, embeddings, checkpoints, logs.
# Anchored to the repository root -- an unanchored "data/" would also swallow
# the mpsae/data package.
/work/
/runs/
/data/
/reports/

# Figures and captions are regenerated by `python -m mpsae report`.
*.png
*.pdf
*.caption.txt

# Generated by setup_server.sh.
.venv/
.venv-scene/
.codex-uv-cache/
.pytest_cache/
/.codex-tests/
/env.sh
.setup-logs/

# Golden fixtures are produced on a GPU box and are meant to be committed, so
# they are deliberately not ignored here.

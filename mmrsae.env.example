# Copy to .env (or use ENV_FILE=mmrsae.env.example after setting credentials).
# Docker loads .env by default; direct execution reads an explicit ENV_FILE.
# Exported values override file defaults; CLI options override both.
# Example: ENV_FILE=mmrsae.env.example bash run_all_experiments_docker.sh --plan
# Paths below are CONTAINER paths. Persistent /data uses DATA_VOLUME.
EXPERIMENT_SCOPE=mmrsae
SUITE_DIR=mmrsae
OUTPUT_ROOT=runs
DATA_VOLUME=graduate-thesis-imagenet
# Optional existing server data/cache directory mounted read/write at /data.
DATA_HOST_DIR=
# Example: device=0 selects one physical GPU (cuda:0 inside Docker).
DOCKER_GPUS=all
IMAGE_NAME=graduate-thesis-mmrsae:latest
SHM_SIZE=16g
PULL_BASE_IMAGE=0

# Use a token with access to ImageNet and the released embedding dataset.
HF_TOKEN=
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=MMRSAE
# Empty selects online when WANDB_API_KEY is set, otherwise offline.
WANDB_MODE=
WANDB_GROUP=imagenet-manual
WANDB_TAGS=imagenet,mmrsae,manual-tuning

# One variant/K/seed per architecture; the two backbones run sequentially.
MMRSAE_BACKBONES=resnet50,resnet18
# mmrsae | mmrsae-rel | mmrsae-wide | mmrsae-annealed
MMRSAE_VARIANT=mmrsae
# Comma-separated methods run sequentially by one `docker compose up`;
# overrides MMRSAE_VARIANT when set.
MMRSAE_VARIANTS=mmrsae,mmrsae-rel,mmrsae-wide,mmrsae-annealed,mpsae,csr
MMRSAE_K=8
MMRSAE_SEED=1227
MMRSAE_DATA_SEED=42
# Empty run name derives a stable name from the resolved recipe.
MMRSAE_RUN_NAME=
MMRSAE_HIDDEN_DIM=8192
MMRSAE_REPAIR_RANK=32

# Affordable default: at most 500 optimizer updates per architecture.
# MAX_STEPS=0 removes this cap; EPOCHS remains the training limit.
MMRSAE_MAX_STEPS=500
MMRSAE_EPOCHS=10
MMRSAE_BATCH_SIZE=1024
MMRSAE_TRAIN_SIZE=128000
MMRSAE_DEV_SIZE=10000
MMRSAE_ANCHOR_COUNT=1024
# dev keeps official validation unopened. official is an explicit final check.
MMRSAE_EVALUATION=dev
MMRSAE_MAX_VAL=0
MMRSAE_EVAL_EVERY=0
MMRSAE_CHECKPOINT_EVERY=25
MMRSAE_LOG_EVERY=10

MMRSAE_LR=4e-5
MMRSAE_WEIGHT_DECAY=1e-4
MMRSAE_ADAM_EPS=6.25e-10
# Optional overrides; empty uses the variant's declared defaults.
MMRSAE_RELATION_WEIGHT=
MMRSAE_OT_WEIGHT=
# Empty uses rho=0.2 for mixed MMRSAE presets and 0 for MPSAE/CSR or no-OT.
# Do not set a shared nonzero override when the method list includes baselines.
MMRSAE_MIXTURE_WEIGHT=
MMRSAE_MASK=
MMRSAE_CLEAN_PROBABILITY=0.2
MMRSAE_ERASE_PROBABILITY=0.25
MMRSAE_TEACHER_TEMPERATURE=0.1
MMRSAE_STUDENT_TEMPERATURE=0.1
MMRSAE_BANK_REFRESH=
MMRSAE_OT_MASS=0.9
MMRSAE_OT_ETA=0.2
MMRSAE_OT_ITERS=100
MMRSAE_OT_MAX_REFINE_ITERS=2000
MMRSAE_OT_TOL=1e-4
MMRSAE_OT_MICROBATCH=32

# Data preparation is automatic at execution time, after CUDA preflight.
# Both backbones train from one flat embeddings folder:
#   1K_{train,val}_ff2048.{npz,json}     ResNet-50 (else downloaded into MMRSAE_CACHE)
#   1K_{train,val}_rn18.{npz,json}       ResNet-18
# Each .json receipt holds the archive SHA-256 (FF2048: also its pinned Hub
# revision, written after the first Hub-verified run), so the folder verifies
# offline on another machine with MMRSAE_DOWNLOAD=0.
# Missing RN18 archives are exported once from the raw images in
# MMRSAE_DATA_ROOT (export_rn18_embeddings.py, centre crop for every row,
# resumable). On a machine without images, copy this folder instead.
MMRSAE_DOWNLOAD=1
MMRSAE_EMBEDDINGS=/data/embeddings
MMRSAE_CACHE=/data/mmrsae
# Raw-image settings, used only by the RN18 export.
MMRSAE_DATA_ROOT=/data/imagenet1k
MMRSAE_DATA_BACKEND=hf
MMRSAE_FEATURE_BATCH_SIZE=256
MMRSAE_WORKERS=4
# Revisions resolve to immutable commits and are retained in cache receipts.
MMRSAE_FF2048_REVISION=main
MMRSAE_IMAGENET_REVISION=main
MMRSAE_PARENT_REVISION=main
# Optional local released archives. Leave empty for automatic retrieval.
# With DOWNLOAD=0, use cached receipts or supply verified immutable revision
# and trusted SHA-256 values for these local files.
MMRSAE_FF2048_TRAIN=
MMRSAE_FF2048_VAL=
MMRSAE_FF2048_TRAIN_SHA256=
MMRSAE_FF2048_VAL_SHA256=
# Optional RN18 archive paths; each needs its .json receipt alongside.
MMRSAE_RN18_TRAIN=
MMRSAE_RN18_VAL=

# GPU retrieval is mandatory; the runner has no CPU fallback.
MMRSAE_DEVICE=cuda:0
MMRSAE_ENCODE_BATCH_SIZE=1024
MMRSAE_QUERY_BATCH_SIZE=32
MMRSAE_GALLERY_CHUNK_SIZE=65536
MMRSAE_SCORE_BUFFER_MIB=256
MMRSAE_GPU_MEMORY_FRACTION=0.8
MMRSAE_FAISS_TEMP_MEMORY_MIB=512
MMRSAE_TIMED_RETRIEVAL=1
MMRSAE_RETRIEVAL_WARMUP=3
MMRSAE_RETRIEVAL_REPEATS=5
# Extra full-parent 1-NN is optional because its dense gallery costs memory.
MMRSAE_DENSE_REFERENCE=0
# 1 (default) keeps training/evaluating through all-zero sparse codes, as the
# original MPSAE runner does; they are counted and empty queries score as misses.
# 0 aborts on the first all-zero code.
MMRSAE_ALLOW_EMPTY_CODES=1
# 1 (default) writes <output>/reports/<group>/ tables and PNG/PDF figures after
# every fitting run, including failed or partial methods; 0 skips them.
MMRSAE_REPORT=1

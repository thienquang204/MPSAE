# CSR Appendix E.1 ResNet-18 study plus the matched MPSAE extension:
#   cp rn18_study.env.example .env
#   # accept the ImageNet-1K dataset terms and replace HF_TOKEN
#   bash run_all_experiments_docker.sh
#
# This protocol intentionally has no MRL arm. Neither the MRL paper nor the
# CSR paper reports a matched ResNet-18 MRL baseline. The paper says that
# three seeds were used but does not publish their values; the set below is
# predeclared for this local study and anchored at the released code's default.

HF_TOKEN=hf_replace_with_a_new_read_only_token

WANDB_API_KEY=
WANDB_ENTITY=tdnthienquang-home
WANDB_PROJECT=MPSAEv2
WANDB_MODE=
WANDB_GROUP=paper-rn18-appendix-e1
WANDB_TAGS=imagenet,csr,mpsae,resnet18,appendix-e1,three-seed-study

DATA_VOLUME=graduate-thesis-imagenet
EXPERIMENT_PROTOCOL=paper_rn18_study
BACKBONES=resnet18
DATA_ROOT=/data/imagenet1k
DATA_PREP=auto
IMAGENET_SPLITS=train,validation
HF_DATASET_ID=ILSVRC/imagenet-1k
HF_REVISION=main
OUTPUT_ROOT=runs
SUITE_DIR=rn18_appendix_e1_study
IMAGE_NAME=graduate-thesis-three-method-ablation:latest
SHM_SIZE=16g
PULL_BASE_IMAGE=0

DEVICE=cuda
WORKERS=8
PREFETCH_FACTOR=2
AMP=0
CHANNELS_LAST=1
TF32=0
SEED=1227
STUDY_SEEDS=1227,1228,1229

# Appendix E.1 / Table 9 controls.
ABLATION_EPOCHS=10
MPSAEV2_EXTRA_EPOCHS=0
ABLATION_BATCH_SIZE=1024
# Matches the released pretrained_embeddings.py extractor default.
FEATURE_BATCH_SIZE=256
MAX_TRAIN=0
MAX_VAL=0
HIDDEN_DIM=8192
V1_TRAIN_K=16
SPARSE_EXTRA_TOPK=
# Exact GPU retrieval; use the same query batch for dense and sparse timing.
KNN_QUERY_BATCH=32
SPARSE_KNN_QUERY_BATCH=32
SPARSE_GALLERY_CHUNK=65536
RETRIEVAL_WARMUP=3
RETRIEVAL_REPEATS=5
SPARSE_SCORE_BUFFER_MIB=256
SPARSE_GPU_MEMORY_FRACTION=0.8

# Shared CSR/MPSAE reconstruction setup. Gamma=1.0 is specific to Table 9.
CSRV2_MAIN_RECON_WEIGHT=1.0
CSRV2_MULTI_TOPK_RECON_WEIGHT=0.125
CSRV2_AUX_RECON_WEIGHT=0.03125
CSRV2_CONTRASTIVE_WEIGHT=1.0
MPSAEV2_MAIN_RECON_WEIGHT=1.0
MPSAEV2_NESTED_RECON_WEIGHT=0.125
MPSAEV2_AUX_RECON_WEIGHT=0.03125

# MMPOT is the declared method-specific MPSAE term, not a CSR paper setting.
MPSAEV2_MMPOT_WEIGHT=2.0
MPSAEV2_LR=4e-5
CSRV2_LR=4e-5
WEIGHT_DECAY=1e-4
ADAM_EPS=6.25e-10
CONTRASTIVE_TEMPERATURE=0.2
OT_MASS=0.9
OT_ETA=0.2
OT_ITERS=100
OT_MICROBATCH=32

FAISS_GPU=1
FAISS_GPU_DEVICE=0
FAISS_TEMP_MEMORY_MIB=512
REBUILD_CACHE=0
FEATURE_CACHE=/data/rn18_a1_feature_cache
WEIGHTS_CACHE=/data/torch
